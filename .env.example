# Local development (run pipeline directly on host)
# DATABASE_URL=postgresql+psycopg2://pipeline_user:pipeline_pass@localhost:5433/pipeline_db

# Docker compose (services talk via internal network)
DATABASE_URL=postgresql+psycopg2://pipeline_user:pipeline_pass@db:5432/pipeline_db

# Source SQLite database path (relative to project root)
SOURCE_DB_PATH=data/raw/northwind.db

# API authentication
API_KEY=dev-key

# API port (only used when running uvicorn directly; docker-compose maps 8000)
API_PORT=8000
